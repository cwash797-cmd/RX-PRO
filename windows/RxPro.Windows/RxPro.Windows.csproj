<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RX-PRO Windows</AssemblyName><Version>0.1.0</Version><InformationalVersion>0.1.0</InformationalVersion>
    <StartupObject>RxPro.Windows.Program</StartupObject><ApplicationManifest>app.manifest</ApplicationManifest>
    <CoreDirectory Condition="'$(CoreDirectory)' == ''">../../.lab/windows-native/bin</CoreDirectory>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../RxPro.Core/RxPro.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="Exists('$(CoreDirectory)/core.sha256')">
    <EmbeddedResource Include="$(CoreDirectory)/core.sha256" LogicalName="CoreHash" />
  </ItemGroup>
</Project>
